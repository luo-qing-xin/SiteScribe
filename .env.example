# Backend (defaults work for local development)
DATABASE_URL=sqlite:///data/site_secretary.db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_HOURS=168
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:3000
UPLOAD_DIR=data/uploads

# Voice audio validation and ASR. Empty ASR_DEFAULT_LANGUAGE enables auto detection.
ASR_PROVIDER=faster_whisper
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_DEFAULT_LANGUAGE=zh
AUDIO_MAX_BYTES=52428800
AUDIO_MAX_DURATION_SECONDS=300
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# OpenAI-compatible Event extraction. Never commit a real API key.
EVENT_EXTRACTION_PROVIDER=openai_compatible
EVENT_EXTRACTION_BASE_URL=
EVENT_EXTRACTION_API_KEY=
EVENT_EXTRACTION_MODEL=
EVENT_EXTRACTION_TIMEOUT_SECONDS=60
EVENT_EXTRACTION_MAX_RETRIES=1

# Record-level multimodal Site Event extraction (Phase 3).
# Use mock for local demos/tests. The OpenAI provider never accepts external image URLs.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EVENT_EXTRACTION_IMAGE_MAX_DIMENSION=1600
EVENT_EXTRACTION_IMAGE_QUALITY=82

# Project knowledge grounded suggestions. Use mock for deterministic demos/tests.
RAG_PROVIDER=mock
RAG_MODEL=mock-grounded-v1
RAG_BASE_URL=
RAG_API_KEY=
RAG_TIMEOUT_SECONDS=60

# Frontend server-side API target. Browser requests stay on the frontend origin.
# Set this in frontend/.env.local only when the API is not 127.0.0.1:8000.
BACKEND_URL=http://127.0.0.1:8000
