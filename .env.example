# Backend (defaults work for local development)
DATABASE_URL=sqlite:///data/site_secretary.db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_HOURS=168
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:3000
UPLOAD_DIR=data/uploads

# Frontend; set this in frontend/.env.local only when the API is not localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
